# DroidSpaces kernel config for Xiaomi Mi Max 2 (oxygen) / halibw LOS21 4.19 kernel
# Appended to arch/arm64/configs/vendor/msm8953-perf_defconfig, then olddefconfig.
# Sources:
#  - Droidspaces-OSS docs: https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md
#  - 1992Ade/msm8937-origin-builder (proven fragment for WALT 4.19 trees)
CONFIG_LOCALVERSION="-perf-droidspaces-fcm"

# --- LTO must be turned OFF explicitly -------------------------------------
# arch/Kconfig declares a *choice* with two members:
#     choice
#         prompt "Link-Time Optimization (LTO) (EXPERIMENTAL)"
#         default LTO_NONE
#     config LTO_NONE   bool "None"
#     config LTO_CLANG  bool "Use clang LTO" ... select LTO
# The vendor defconfig sets CONFIG_LTO_CLANG=y, and for a choice group
# olddefconfig keeps whatever the defconfig selected unless the *chosen* member
# is switched. Writing only "# CONFIG_LTO_CLANG is not set" does NOT switch it
# back to LTO_NONE, so LTO stayed on and `LTO vmlinux.o` needed ~7 GB on a
# 7 GB / 2-core runner -> the job was killed with SIGTERM (exit 143).
# Selecting LTO_NONE=y is what actually moves the choice off clang LTO.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_PERMISSIVE is not set

# IPC mechanisms
CONFIG_SYSCTL=y
# NOTE: FCM 5 requires CONFIG_SYSVIPC=n, but DroidSpaces needs it for container IPC
# namespaces (CONFIG_IPC_NS). This is a DELIBERATE deviation: the "device has an
# internal problem" dialog will still appear at boot. Everything else is kept at
# FCM-compliant values to minimise the mismatch.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y

# Device filesystem / tmpfs
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
# CONFIG_FHANDLE is not set
# ^ FCM 5 requires FHANDLE=n; DroidSpaces does not need it. Keeping it =y triggers
#   the "device has an internal problem" dialog (VintfObject.verifyWithoutAvb()=1).

# Firmware loading
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# DroidSpaces network isolation (NAT mode)
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_TABLES=y

# IPv6 NAT (optional, NAT66) -- DISABLED to satisfy FCM 5 (requires IP6_NF_NAT=n).
# DroidSpaces NAT mode only needs IPv4 (IP_NF_NAT / MASQUERADE above).
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
# CONFIG_IP6_NF_NAT is not set
# CONFIG_IP6_NF_TARGET_MASQUERADE is not set

# Macvlan mode (optional)
CONFIG_MACVLAN=y

# Fix for docker unsafe procfs error
# CONFIG_ANDROID_PARANOID_NETWORK is not set
